[Unit]
Description=Ollama, una's cleanup model
After=network-online.target

[Service]
ExecStart=@SHARE@/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
# one model resident: the card's memory is shared with Whisper
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_FLASH_ATTENTION=1
# a cleanup prompt is ~250 tokens plus the dictation; 4096 would hold KV cache for nothing
Environment=OLLAMA_CONTEXT_LENGTH=2048
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
