{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Una",
  "version": "0.1.0",
  "identifier": "sh.tenet.una",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "beforeBuildCommand": "bun run --cwd ../ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Self-hosted dictation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
